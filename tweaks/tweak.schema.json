{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trashsweepr - arquivo de catálogo",
  "description": "Estrutura dos arquivos de tweaks e perfis. A validação definitiva (deny-list de componentes críticos, regras de risco) é feita pelo trashsweepr ao carregar.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tweaks": { "type": "array", "items": { "$ref": "#/$defs/tweak" } },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "description": "Texto em pt-BR ou objeto { cultura: texto } (ex.: pt-BR, en-US).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 }
      ]
    },
    "tweak": {
      "type": "object",
      "required": ["id", "name", "description", "category", "risk", "apply", "revert"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "category": { "enum": ["apps", "privacy", "services", "tasks", "interface", "performance"] },
        "risk": { "enum": ["safe", "moderate", "advanced"] },
        "requiresReboot": { "type": "boolean" },
        "optIn": { "type": "boolean", "description": "Nunca entra em perfis pré-definidos." },
        "riskNote": { "$ref": "#/$defs/text", "description": "Obrigatório para moderate/advanced." },
        "revertNote": { "$ref": "#/$defs/text" },
        "minBuild": { "type": "integer", "minimum": 22000 },
        "maxBuild": { "type": "integer", "minimum": 22000 },
        "apply": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
        "revert": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
      },
      "if": { "properties": { "risk": { "enum": ["moderate", "advanced"] } }, "required": ["risk"] },
      "then": { "required": ["riskNote"] }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/registryAction" },
        { "$ref": "#/$defs/serviceAction" },
        { "$ref": "#/$defs/scheduledTaskAction" },
        { "$ref": "#/$defs/appxAction" }
      ]
    },
    "registryAction": {
      "type": "object",
      "required": ["type", "hive", "path"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "registry" },
        "operation": { "enum": ["set", "deleteValue", "deleteKey"], "default": "set" },
        "hive": { "enum": ["hkcu", "hklm"] },
        "path": { "type": "string", "description": "Caminho sem o hive, ex.: Software\\Microsoft\\..." },
        "name": { "type": "string", "description": "Nome do valor; \"\" é o valor padrão da chave." },
        "kind": { "enum": ["dword", "qword", "sz", "expandSz"], "default": "dword" },
        "value": { "type": ["integer", "string"] }
      }
    },
    "serviceAction": {
      "type": "object",
      "required": ["type", "name", "startType"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "service" },
        "name": { "type": "string" },
        "startType": { "enum": ["automatic", "automaticDelayed", "manual", "disabled"] },
        "stop": { "type": "boolean" }
      }
    },
    "scheduledTaskAction": {
      "type": "object",
      "required": ["type", "taskPath", "taskName", "enabled"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scheduledTask" },
        "taskPath": { "type": "string", "description": "Ex.: \\Microsoft\\Windows\\Application Experience\\" },
        "taskName": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "appxAction": {
      "type": "object",
      "required": ["type", "operation", "packageName"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "appx" },
        "operation": { "enum": ["remove", "reinstall"] },
        "packageName": { "type": "string", "description": "Nome exato do pacote, sem curingas." }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "description", "maxRisk"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "maxRisk": { "enum": ["safe", "moderate"], "description": "'advanced' nunca é permitido em perfis." }
      }
    }
  }
}
