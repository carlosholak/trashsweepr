<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>trashsweepr</AssemblyName>
    <RootNamespace>TrashSweepr</RootNamespace>
    <Product>trashsweepr</Product>
    <Version>1.3.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Limpeza\Core\Limpeza.Core.csproj" />
    <ProjectReference Include="..\Limpeza\Infrastructure\Limpeza.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- O catálogo da Limpeza do Windows é copiado para <exe>\tweaks -->
  <ItemGroup>
    <Content Include="..\..\tweaks\*.json" Link="tweaks\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrashSweepr.Tests" />
    <!-- O SDK do WPF não importa System.IO por padrão. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>