<Window x:Class="TrashSweepr.Cleanup.Views.ConfirmRisksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrashSweepr.Localization"
        xmlns:vm="clr-namespace:TrashSweepr.Cleanup.ViewModels"
        Title="{loc:T Dialog.RiskTitle}"
        Width="580" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:T Dialog.RiskTitle}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{loc:T Dialog.RiskIntro}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RiskConfirmationRow}">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RiskText}" FontWeight="SemiBold" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Danger}">
                                                        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </DockPanel>
                                <Border BorderBrush="{StaticResource Bad}" BorderThickness="3,0,0,0" Padding="10,2,0,2" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" LineHeight="19"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <CheckBox Grid.Row="3" Content="{loc:T Dialog.RiskCheckbox}" IsChecked="{Binding Accepted, Mode=TwoWay}" Margin="0,8,0,18"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T Dialog.Cancel}" Style="{StaticResource Btn}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" Padding="12,6" Click="OnCancel"/>
            <Button Content="{loc:T Dialog.RiskContinue}" Style="{StaticResource PrimaryBtn}" MinWidth="120" Padding="12,6"
                    IsEnabled="{Binding Accepted}" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>