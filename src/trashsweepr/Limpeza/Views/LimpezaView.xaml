<UserControl x:Class="TrashSweepr.Limpeza.Views.LimpezaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrashSweepr.Limpeza.Services"
             xmlns:conv="clr-namespace:TrashSweepr.Limpeza.Converters"
             xmlns:vm="clr-namespace:TrashSweepr.Limpeza.ViewModels"
             Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="EmptyToVisible"/>
        <conv:NullToVisibilityConverter x:Key="NotEmptyToVisible" Invert="True"/>
        <conv:DimWhenFalseConverter x:Key="DimWhenFalse"/>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>

        <!-- Risco: só o que pede atenção ganha destaque. -->
        <Style x:Key="RiskText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estado: verde só para "aplicado" (a mesma cor que o mapa usa para o que diminuiu). -->
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Positive}">
                    <Setter Property="Foreground" Value="{StaticResource Good}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Neutral}">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Positive}">
                    <Setter Property="Foreground" Value="{StaticResource Good}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Neutral}">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Faixa de aviso: filete à esquerda; a cor do filete diz a gravidade. -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Neutral}">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Danger}">
                    <Setter Property="BorderBrush" Value="{StaticResource Bad}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FilterOption">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}"/>
                <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Item de lista com marcador (o que o tweak faz / como desfazer) -->
        <DataTemplate x:Key="BulletItem">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de ferramentas: perfil, busca e modo simulação -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{loc:T Profile.Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="150" Padding="8,5" VerticalAlignment="Center" ItemsSource="{Binding ProfileFilter.Options}"
                          SelectedItem="{Binding ProfileFilter.Selected, Mode=TwoWay}" DisplayMemberPath="Label"/>

                <Grid Width="250" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Padding="7,5" BorderBrush="{StaticResource Line}" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{loc:T Search.Placeholder}" Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{loc:T Run.Refresh}" Command="{Binding RefreshCommand}"/>
                <CheckBox DockPanel.Dock="Right" Margin="0,0,18,0" VerticalAlignment="Center" Content="{loc:T Mode.DryRun}"
                          ToolTip="{loc:T Mode.DryRunHint}" IsChecked="{Binding IsDryRun, Mode=TwoWay}"/>
            </DockPanel>
        </Border>

        <!-- Avisos -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Banners}" Margin="14,10,14,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BannerItem}">
                    <Border Style="{StaticResource Notice}" Tag="{Binding Tone}" Margin="0,0,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                    Content="{loc:T Banner.ElevateAction}"
                                    Command="{Binding DataContext.RelaunchAsAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding OffersElevation, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Conteúdo: lista | detalhes e resultado -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="420" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de tweaks -->
            <Border Grid.Column="0" Margin="14,14,0,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="12,10,12,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="{loc:T Filter.Categories}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="210" Padding="8,4" ItemsSource="{Binding CategoryFilter.Options}"
                                      SelectedItem="{Binding CategoryFilter.Selected, Mode=TwoWay}" ItemTemplate="{StaticResource FilterOption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="{loc:T Filter.Risk}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="120" Padding="8,4" ItemsSource="{Binding RiskFilter.Options}"
                                      SelectedItem="{Binding RiskFilter.Selected, Mode=TwoWay}" ItemTemplate="{StaticResource FilterOption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{loc:T Filter.State}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="140" Padding="8,4" ItemsSource="{Binding StateFilter.Options}"
                                      SelectedItem="{Binding StateFilter.Selected, Mode=TwoWay}" ItemTemplate="{StaticResource FilterOption}"/>
                        </StackPanel>
                    </WrapPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="14,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ListCountText}" Foreground="{StaticResource Muted}"/>
                            <CheckBox Content="{loc:T List.SelectAllVisible}" IsChecked="{Binding SelectAllVisible, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource Row}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemsSource="{Binding VisibleTweaks}" SelectedItem="{Binding SelectedTweak, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                                    <Grid Opacity="{Binding CanSelect, Converter={StaticResource DimWhenFalse}}" ToolTip="{Binding CompatibilityMessage}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{loc:T Badge.OptIn}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,2,0,0"
                                                           Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding RiskText}" Style="{StaticResource RiskText}" Tag="{Binding RiskTone}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource StateText}" Tag="{Binding StateTone}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{loc:T List.Empty}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="{Binding HasNoVisibleTweaks, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Detalhes / Resultado -->
            <Border Grid.Column="2" Margin="0,14,14,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Tab}" GroupName="LimpezaTab" Content="{loc:T Details.Title}"
                                         IsChecked="{Binding IsDetailsTab, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource Tab}" GroupName="LimpezaTab" Content="{loc:T Details.Results}"
                                         IsChecked="{Binding IsResultsTab, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- Detalhes -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDetailsTab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Details.NothingSelected}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="28" VerticalAlignment="Center" LineHeight="19"
                                   Visibility="{Binding SelectedTweak, Converter={StaticResource EmptyToVisible}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedTweak, Converter={StaticResource NotEmptyToVisible}}">
                            <StackPanel DataContext="{Binding SelectedTweak}" Margin="16,14,16,16">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                                    <Run Text="{Binding CategoryText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RiskText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StateText, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0"/>

                                <Border Style="{StaticResource Notice}" Tag="{Binding RiskTone}" Margin="0,14,0,0"
                                        Visibility="{Binding HasRiskNote, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Details.RiskWarning}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RiskNote}" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Notice}" Margin="0,14,0,0"
                                        Visibility="{Binding HasCompatibilityMessage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CompatibilityMessage}" TextWrapping="Wrap" LineHeight="19"/>
                                </Border>

                                <TextBlock Text="{loc:T Details.WhatItDoes}" Style="{StaticResource Heading}"/>
                                <ItemsControl ItemsSource="{Binding ApplyDescriptions}" ItemTemplate="{StaticResource BulletItem}"/>

                                <TextBlock Text="{loc:T Details.HowToRevert}" Style="{StaticResource Heading}"/>
                                <TextBlock Text="{Binding RevertNote}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,6"
                                           Visibility="{Binding HasRevertNote, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{loc:T Details.RevertWithBackup}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                <TextBlock Text="{loc:T Details.RevertActions}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,4"/>
                                <ItemsControl ItemsSource="{Binding RevertDescriptions}" ItemTemplate="{StaticResource BulletItem}"/>

                                <TextBlock Text="{loc:T Details.RequiresReboot}" TextWrapping="Wrap" LineHeight="19" Margin="0,14,0,0"
                                           Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{loc:T Details.OptInNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"
                                           Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Consolas" Margin="0,14,0,0"/>

                                <Button Content="{loc:T Details.UndoButton}" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Command="{Binding DataContext.RevertSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Resultados -->
                    <Grid Grid.Row="1" Visibility="{Binding IsResultsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:T Result.None}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                   Margin="28" VerticalAlignment="Top" Grid.RowSpan="2"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Margin="16,12,16,6" Visibility="{Binding SummaryText, Converter={StaticResource NotEmptyToVisible}}">
                            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            <TextBlock Text="{Binding RestorePointText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"
                                       Visibility="{Binding RestorePointText, Converter={StaticResource NotEmptyToVisible}}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ResultItemViewModel}">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,9">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource ResultText}"
                                                               Tag="{Binding Tone}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding TweakName}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                                           Margin="0,3,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource Crumb}" Content="{Binding ToggleCommandsText}" Command="{Binding ToggleCommandsCommand}"
                                                        HorizontalAlignment="Left" Margin="-5,4,0,0"
                                                        Visibility="{Binding HasCommands, Converter={StaticResource BoolToVis}}"/>
                                                <TextBox Text="{Binding CommandsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                                         Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" Padding="6,4" Margin="0,4,0,0"
                                                         Visibility="{Binding ShowCommands, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de ações -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Content="{loc:T Run.RevertAll}" Command="{Binding RevertAllCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn}" Content="{loc:T Run.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding RunButtonText}" Command="{Binding RunCommand}" MinWidth="200"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Height="3" Width="360" HorizontalAlignment="Left"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Track}" BorderThickness="0" Margin="0,0,0,6"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
